@model PizzaApp.Models.Pizza

@{
    ViewData["Title"] = "Добавить новую пиццу";
}

<style>
    .create-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 40px 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .form-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3);
        max-width: 600px;
        margin: 0 auto;
    }

    .form-card h1 {
        color: #333;
        margin-bottom: 10px;
        font-size: 32px;
    }

    .form-card p {
        color: #666;
        margin-bottom: 30px;
        font-size: 16px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-group label {
        display: block;
        color: #333;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 16px;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 16px;
        font-family: inherit;
        transition: all 0.3s ease;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 15px rgba(102, 126, 234, 0.3);
        background: #f8f9ff;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 100px;
    }

    .form-buttons {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-submit {
        flex: 1;
        padding: 14px 30px;
        background: linear-gradient(45deg, #4caf50, #45a049);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(76, 175, 80, 0.4);
    }

    .btn-cancel {
        flex: 1;
        padding: 14px 30px;
        background: #ccc;
        color: #333;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
    }

    .btn-cancel:hover {
        background: #bbb;
        transform: translateY(-2px);
    }

    .help-text {
        color: #999;
        font-size: 13px;
        margin-top: 5px;
    }

    .validation-error {
        color: #ff6b6b;
        font-size: 13px;
        margin-top: 5px;
    }
</style>

<div class="create-container">
    <div class="form-card">
        <h1>🍕 Добавить новую пиццу</h1>
        <p>Создай свою уникальную пиццу и добавь её в меню!</p>

        <form method="post" asp-action="Create">
            <div class="form-group">
                <label asp-for="Name">Название пиццы *</label>
                <input asp-for="Name" placeholder="Например: Маргарита" required>
                <span asp-validation-for="Name" class="validation-error"></span>
                <div class="help-text">Придумай привлекательное название</div>
            </div>

            <div class="form-group">
                <label asp-for="Description">Описание *</label>
                <textarea asp-for="Description" placeholder="Опиши вкус и особенности пиццы..." required></textarea>
                <span asp-validation-for="Description" class="validation-error"></span>
                <div class="help-text">Расскажи, что делает эту пиццу особенной</div>
            </div>

            <div class="form-group">
                <label asp-for="Price">Цена (₽) *</label>
                <input asp-for="Price" type="number" step="0.01" placeholder="499" required>
                <span asp-validation-for="Price" class="validation-error"></span>
                <div class="help-text">Введи цену в рублях</div>
            </div>

            <div class="form-group">
                <label asp-for="ImageUrl">URL изображения</label>
                <input asp-for="ImageUrl" placeholder="https://example.com/pizza.jpg">
                <span asp-validation-for="ImageUrl" class="validation-error"></span>
                <div class="help-text">Ссылка на красивое фото пиццы</div>
            </div>

            <div class="form-group">
                <label>Ингредиенты (через запятую)</label>
                <textarea id="ingredientsInput" placeholder="Тесто, Томат, Моцарелла, Базилик, Оливки"></textarea>
                <span class="validation-error" id="ingredientsError"></span>
                <div class="help-text">Введи все ингредиенты, разделяя их запятыми</div>
            </div>

            <div class="form-buttons">
                <button type="submit" class="btn-submit">✅ Добавить пиццу</button>
                <a href="/" class="btn-cancel">❌ Отмена</a>
            </div>
        </form>
    </div>
</div>

<script>
document.querySelector('form').addEventListener('submit', function(e) {
    const ingredientsInput = document.getElementById('ingredientsInput').value;
    const ingredientsError = document.getElementById('ingredientsError');
    
    if (!ingredientsInput.trim()) {
        ingredientsError.textContent = 'Пожалуйста, добавь хотя бы один ингредиент';
        e.preventDefault();
        return;
    }

    const ingredients = ingredientsInput.split(',').map(i => i.trim()).filter(i => i);
    const ingredientsJson = JSON.stringify(ingredients);
    
    let input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'Ingredients';
    input.value = ingredientsJson;
    this.appendChild(input);
});
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
