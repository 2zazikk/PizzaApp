@model List<PizzaApp.Models.Pizza>

<div class="container">
    <h1 class="mb-4">🍕 Наше меню</h1>
    
    <div class="row">
        @foreach (var pizza in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card pizza-card">
                    <img src="@pizza.ImageUrl" class="card-img-top" alt="@pizza.Name" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@pizza.Name</h5>
                        <p class="card-text">@pizza.Description</p>
                        <p class="text-muted">
                            <small>Ингредиенты: @string.Join(", ", pizza.Ingredients)</small>
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0">₽@pizza.Price</span>
                            <div>
                                <a href="/pizza/details/@pizza.Id" class="btn btn-sm btn-outline-primary">Подробнее</a>
                                <a href="/pizza/addtocart/@pizza.Id" class="btn btn-sm btn-primary">В корзину</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>