@model List<PizzaApp.Models.Pizza>

@{
    ViewData["Title"] = "🍕 PizzaApp - Лучшая пиццерия";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .navbar {
        background: rgba(0, 0, 0, 0.9) !important;
        backdrop-filter: blur(10px);
        border-bottom: 3px solid #ffc107;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .navbar-brand {
        font-size: 28px !important;
        font-weight: bold;
        background: linear-gradient(45deg, #ff6b6b, #ffc107);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 60px 20px;
        text-align: center;
        border-radius: 20px;
        margin: 30px 0;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    .hero-section h1 {
        font-size: 48px;
        margin-bottom: 20px;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
    }

    .search-sort-section {
        background: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 40px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .search-sort-section h3 {
        color: #333;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .search-form {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .search-form input,
    .search-form select {
        padding: 12px 15px;
        border: 2px solid #667eea;
        border-radius: 10px;
        font-size: 16px;
        transition: all 0.3s ease;
    }

    .search-form input:focus,
    .search-form select:focus {
        outline: none;
        border-color: #764ba2;
        box-shadow: 0 0 10px rgba(118, 75, 162, 0.3);
    }

    .search-form input {
        flex: 1;
        min-width: 200px;
    }

    .search-form button {
        padding: 12px 30px;
        background: linear-gradient(45deg, #ff6b6b, #ffc107);
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .search-form button:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 107, 107, 0.4);
    }

    .add-pizza-btn {
        background: linear-gradient(45deg, #4caf50, #45a049);
        color: white;
        padding: 15px 30px;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 20px;
    }

    .add-pizza-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(76, 175, 80, 0.4);
    }

    .pizzas-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
    }

    .pizza-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        transform: translateY(0);
    }

    .pizza-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
    }

    .pizza-card img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .pizza-card:hover img {
        transform: scale(1.05);
    }

    .pizza-card-body {
        padding: 20px;
    }

    .pizza-card-title {
        font-size: 20px;
        font-weight: bold;
        color: #333;
        margin-bottom: 10px;
    }

    .pizza-card-description {
        color: #666;
        font-size: 14px;
        margin-bottom: 10px;
        line-height: 1.4;
    }

    .pizza-ingredients {
        color: #999;
        font-size: 12px;
        margin-bottom: 15px;
        max-height: 40px;
        overflow: hidden;
    }

    .pizza-price {
        font-size: 24px;
        font-weight: bold;
        color: #ff6b6b;
        margin-bottom: 15px;
    }

    .pizza-buttons {
        display: flex;
        gap: 10px;
    }

    .btn-details {
        flex: 1;
        padding: 10px;
        background: #667eea;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
    }

    .btn-details:hover {
        background: #764ba2;
        transform: translateY(-2px);
    }

    .btn-cart {
        flex: 1;
        padding: 10px;
        background: #ff6b6b;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
    }

    .btn-cart:hover {
        background: #ff5252;
        transform: translateY(-2px);
    }

    .no-pizzas {
        text-align: center;
        color: white;
        font-size: 24px;
        padding: 40px;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }
</style>

<div class="container">
    <div class="hero-section">
        <h1>🍕 Добро пожаловать в PizzaApp!</h1>
        <p>Лучшая пицца в городе. Быстро, вкусно, с доставкой!</p>
    </div>

    <div style="text-align: center; margin-bottom: 20px;">
        <a href="/pizza/create" class="add-pizza-btn">➕ Добавить новую пиццу</a>
    </div>

    <div class="search-sort-section">
        <h3>🔍 Поиск и фильтры</h3>
        <form method="get" class="search-form">
            <input type="text" name="search" placeholder="Поиск пиццы..." value="@ViewBag.Search">
            
            <select name="sort">
                <option value="">Сортировка</option>
                <option value="price_asc" selected="@(ViewBag.Sort == "price_asc" ? "selected" : "")">💰 По цене (возрастание)</option>
                <option value="price_desc" selected="@(ViewBag.Sort == "price_desc" ? "selected" : "")">💰 По цене (убывание)</option>
                <option value="name" selected="@(ViewBag.Sort == "name" ? "selected" : "")">A-Z По названию</option>
            </select>
            
            <button type="submit">🔎 Поиск</button>
            <a href="/" style="padding: 12px 20px; background: #999; color: white; border-radius: 10px; text-decoration: none; font-weight: 600;">✖️ Очистить</a>
        </form>
    </div>

    @if (Model.Any())
    {
        <div class="pizzas-grid">
            @foreach (var pizza in Model)
            {
                <div class="pizza-card">
                    <img src="@pizza.ImageUrl" alt="@pizza.Name" onerror="this.src='https://via.placeholder.com/300x200?text=Pizza'">
                    <div class="pizza-card-body">
                        <div class="pizza-card-title">@pizza.Name</div>
                        <div class="pizza-card-description">@pizza.Description</div>
                        <div class="pizza-ingredients">
                            🥘 @string.Join(", ", pizza.Ingredients ?? new List<string>())
                        </div>
                        <div class="pizza-price">₽@pizza.Price</div>
                        <div class="pizza-buttons">
                            <a href="/pizza/details/@pizza.Id" class="btn-details">📋 Подробнее</a>
                            <a href="/pizza/addtocart/@pizza.Id" class="btn-cart">🛒 В корзину</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-pizzas">
            😞 Пиццы не найдены. Попробуй другой поиск!
        </div>
    }
</div>

<style>
    @@media (max-width: 768px) {
        .pizzas-grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        }

        .hero-section h1 {
            font-size: 32px;
        }

        .search-form {
            flex-direction: column;
        }

        .search-form input,
        .search-form select,
        .search-form button {
            width: 100%;
        }
    }
</style>
